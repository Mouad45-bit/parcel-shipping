# Secret JWT Base64 représentant au minimum 32 octets aléatoires.
AUTH_JWT_SECRET=

# false uniquement pour le développement local en HTTP.
AUTH_COOKIE_SECURE=false

# Active uniquement la génération des POD de démonstration.
SHIPMENT_POD_SEED_ENABLED=false

# Stabilise la répartition pseudo-aléatoire entre les redémarrages.
# Cette valeur n'est pas un secret de sécurité.
SHIPMENT_POD_SEED_RANDOM_SEED=parcel-shipping-demo-2026

SHIPMENT_POD_SEED_MINIMUM_COUNT=1
SHIPMENT_POD_SEED_MAXIMUM_COUNT=3
SHIPMENT_POD_SEED_BATCH_SIZE=100
SHIPMENT_POD_SEED_FAIL_FAST=true
